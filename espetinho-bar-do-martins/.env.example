# URL pública do site (usada em SEO, sitemap e links de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Supabase (Project Settings → API). A chave "anon"/"publishable" é pública por natureza;
# a segurança das gravações é feita pelas políticas RLS e pelas verificações no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
